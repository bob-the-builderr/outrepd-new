<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always draw their own launch screen: the
         launcher icon on a plain colour. Left to itself that colour is white,
         so this sets it to the app's dark page colour. The icon's own
         background is the same colour, so the lifters sit on one dark screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
