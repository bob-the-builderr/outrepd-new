<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (lib/push.dart). "development" here; exporting for
	     the App Store switches it to production when the build is signed. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- outrepd.com/u/<name> opens the app (lib/deep_links.dart), checked
	     against the site's .well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.outrepd.com</string>
		<string>applinks:outrepd.com</string>
	</array>
</dict>
</plist>
